{
  "version": 1,
  "rules": [
    {
      "name": "api-default",
      "path_prefix": "/api/",
      "limit": 100,
      "window": "1m",
      "key": "ip"
    },
    {
      "name": "users",
      "path_prefix": "/api/users",
      "limit": 10,
      "window": "1s",
      "key": "user"
    },
    {
      "name": "orders-global",
      "path_prefix": "/api/orders",
      "limit": 50,
      "window": "1m",
      "key": "global"
    }
  ]
}
